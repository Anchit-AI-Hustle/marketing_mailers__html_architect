{
  "name": "vahdam-mailer-architect",
  "version": "1.0.0",
  "private": true,
  "description": "VAHDAM Mailer Studio — static HTML SPA with Vercel serverless functions for OpenAI server-side calls.",
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "build": "node scripts/build-catalog.js",
    "dev": "node -e \"require('http').createServer().listen(3001)\"",
    "deploy": "vercel --prod",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:install": "playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0"
  }
}
